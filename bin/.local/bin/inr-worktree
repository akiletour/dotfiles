#!/usr/bin/env bash
set -euo pipefail

export DOCKER_CONTEXT=orbstack

worktree=${WM_WORKTREE_PATH:-$PWD}
root=${WM_PROJECT_ROOT:-$(git -C "$worktree" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')}
handle=${WM_HANDLE:-$(basename "$worktree")}

inr() {
  task --taskfile "${INR_DEV_DIR:-$HOME/www/Tools/inr-traefik}/Taskfile.yml" "$@"
}

slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//'
}

local_setting() {
  [[ -f "$HOME/.zshrc.local" ]] || return 0
  sed -n "s/^export $1=//p" "$HOME/.zshrc.local" | tail -1 | tr -d "\"'" | sed -e "s|^\$HOME|$HOME|" -e "s|^~|$HOME|"
}

if [[ -z ${WORKTREE_MAKE_STACK_VAR:-} ]]; then
  WORKTREE_MAKE_STACK_VAR=$(local_setting WORKTREE_MAKE_STACK_VAR)
fi
if [[ -n ${WORKTREE_MAKE_STACK_VAR:-} && -z ${!WORKTREE_MAKE_STACK_VAR:-} ]]; then
  export "$WORKTREE_MAKE_STACK_VAR=$(local_setting "$WORKTREE_MAKE_STACK_VAR")"
fi

mk_project() {
  [[ "$root" != "$worktree" && -f "$root/docker/.env" && -f "$root/Makefile" ]] && [[ -n ${WORKTREE_MAKE_STACK_VAR:-} ]] && grep -q "$WORKTREE_MAKE_STACK_VAR" "$root/Makefile"
}

mk_value() {
  [[ -f $2 ]] || return 0
  sed -n "s/^$1=//p" "$2" | tail -1 | tr -d "\"'"
}

mk_setup() {
  local base name line key path domain
  base=$(mk_value PROJECT_NAME "$root/docker/.env")
  name="$base-$(slug "$handle")"
  umask 077
  {
    [[ -f "$root/docker/.env.local" ]] && grep -vE '^(PROJECT_NAME|SUB_DOMAIN_NAME)=' "$root/docker/.env.local"
    echo "PROJECT_NAME=$name"
    echo "SUB_DOMAIN_NAME=$name"
    while IFS= read -r line || [[ -n $line ]]; do
      key=${line%%=*}
      [[ $key == PROJECT_NAME || $key == SUB_DOMAIN_NAME ]] && continue
      if [[ $line == *'${PROJECT_NAME}'* || $line == *'${SUB_DOMAIN_NAME}'* ]]; then
        line=${line//'${PROJECT_NAME}'/$name}
        echo "${line//'${SUB_DOMAIN_NAME}'/$name}"
      fi
    done < "$root/docker/.env"
  } > "$worktree/docker/.env.local"
  while IFS= read -r path; do
    [[ -e "$worktree/$path" ]] && continue
    mkdir -p "$worktree/$(dirname "$path")"
    cp -Rp "$root/$path" "$worktree/$path"
  done < <(git -C "$root" ls-files --others --ignored --exclude-standard -- '.envrc' '.env*.local' 'config/jwt/*')
  if [[ -d "$root/vendor" && ! -e "$worktree/vendor" ]]; then
    cp -Rc "$root/vendor" "$worktree/vendor" 2>/dev/null || cp -R "$root/vendor" "$worktree/vendor"
  fi
  domain="$(mk_value DOMAIN_NAME "$root/docker/.env").$(mk_value DOMAIN_EXTENSION "$root/docker/.env")"
  echo "stack: $name -> https://$name.$domain"
}

mk_up() {
  local base name marker i
  cd "$worktree"
  base=$(mk_value PROJECT_NAME "$root/docker/.env")
  name=$(mk_value PROJECT_NAME docker/.env.local)
  if [[ -z $name || $name == "$base" ]]; then
    echo "stack: docker/.env.local n'a pas de PROJECT_NAME propre au worktree, lance 'inr-worktree setup' d'abord" >&2
    return 1
  fi
  marker="$(git rev-parse --absolute-git-dir)/stack-database"
  make start
  if [[ -f composer.json ]]; then
    docker exec "$name-app" composer install --no-interaction --no-progress || echo "stack: composer install a échoué, relance 'make composer install'" >&2
  fi
  [[ -f $marker ]] && return 0
  for i in $(seq 60); do
    docker exec "$name-database" pg_isready -q -h 127.0.0.1 2>/dev/null && break
    sleep 1
  done
  if docker ps --format '{{.Names}}' | grep -qx "$base-database"; then
    docker exec "$base-database" sh -c 'pg_dump --no-owner -U "$POSTGRES_USER" "$POSTGRES_DB"' |
      docker exec -i "$name-database" sh -c 'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" "$POSTGRES_DB"' >/dev/null
    echo "stack: base copiée depuis $base-database"
  else
    echo "stack: $base-database ne tourne pas, base vide : lance make migrate" >&2
  fi
  touch "$marker"
}

mk_down() {
  local name
  name=$(mk_value PROJECT_NAME "$worktree/docker/.env.local")
  [[ -n $name ]] || return 0
  docker compose -p "$name" down -v --remove-orphans || echo "stack: arrêt impossible, lance 'inr-worktree prune' plus tard" >&2
}

excluded() {
  local key=$1 pattern
  [[ -f "$root/.inr/worktree.exclude" ]] || return 1
  while IFS= read -r pattern; do
    [[ -n $pattern && $key == $pattern ]] && return 0
  done < "$root/.inr/worktree.exclude"
  return 1
}

setup() {
  [[ -f "$root/.env.inr" && "$root" != "$worktree" ]] || return 0
  local base name main_url line key value
  base=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$root/.env.inr")
  name="$base-$(slug "$handle")"
  main_url="https://$base.inr.local,$base.inr.local"
  umask 077
  while IFS= read -r line || [[ -n $line ]]; do
    key=${line%%=*}
    case $key in
      COMPOSE_PROJECT_NAME) echo "COMPOSE_PROJECT_NAME=$name" ;;
      INR_PROD_URLS) value=${line#*=}; echo "INR_PROD_URLS=${value:+$value,}$main_url" ;;
      *) excluded "$key" || echo "$line" ;;
    esac
  done < "$root/.env.inr" > "$worktree/.env.inr"
  grep -q '^INR_PROD_URLS=' "$worktree/.env.inr" || echo "INR_PROD_URLS=$main_url" >> "$worktree/.env.inr"
  [[ -d "$root/.git" ]] && echo "INR_GIT_COMMON_DIR=$root/.git" >> "$worktree/.env.inr"
  for file in .envrc compose.inr.yml; do
    if [[ -f "$root/$file" && ! -e "$worktree/$file" ]]; then
      cp -p "$root/$file" "$worktree/$file"
    fi
  done
  if [[ -f "$root/.inr/worktree.copy" ]]; then
    local pattern path
    while IFS= read -r pattern; do
      [[ -n $pattern ]] || continue
      for path in "$root"/$pattern; do
        [[ -e $path ]] || continue
        path=${path#"$root"/}
        [[ -e "$worktree/$path" ]] && continue
        mkdir -p "$worktree/$(dirname "$path")"
        cp -Rp "$root/$path" "$worktree/$path"
      done
    done < "$root/.inr/worktree.copy"
  fi
  if [[ -f "$worktree/.envrc" ]] && ! git -C "$worktree" ls-files --error-unmatch .envrc >/dev/null 2>&1; then
    grep -q '^export COMPOSE_PROJECT_NAME=' "$worktree/.envrc" || echo "export COMPOSE_PROJECT_NAME=$name" >> "$worktree/.envrc"
  fi
  echo "inr: $name -> https://$name.inr.local"
}

up() {
  [[ -f "$worktree/.env.inr" && "$root" != "$worktree" ]] || return 0
  cd "$worktree"
  local snapshot
  snapshot=$(ls -t "$root"/.inr/snapshots/*.sql 2>/dev/null | head -1 || true)
  if [[ -n $snapshot && ! -f .inr/restored ]]; then
    inr start -- --wait database
    inr restore -- "$snapshot"
    mkdir -p .inr && touch .inr/restored
  fi
  inr start
}

down() {
  [[ -f "$worktree/.env.inr" && "$root" != "$worktree" ]] || return 0
  (cd "$worktree" && inr down -- -v) || echo "inr: arrêt impossible, lance 'inr-worktree prune' plus tard" >&2
}

prune() {
  local name dir answer
  docker ps -a --filter label=com.docker.compose.project \
    --format '{{.Label "com.docker.compose.project"}}	{{.Label "com.docker.compose.project.working_dir"}}' |
    sort -u |
    while IFS=$'\t' read -r name dir; do
      [[ -n $dir && ! -d $dir ]] || continue
      read -r -p "inr: $name pointe vers $dir qui n'existe plus. Supprimer conteneurs et volumes ? [y/N] " answer < /dev/tty
      if [[ $answer == y ]]; then
        docker compose -p "$name" down -v --remove-orphans
      fi
    done
}

case ${1:-} in
  setup) if mk_project; then mk_setup; else setup; fi ;;
  up) if mk_project; then mk_up; else up; fi ;;
  down) if mk_project; then mk_down; else down; fi ;;
  prune) prune ;;
  *) echo "usage: inr-worktree setup|up|down|prune" >&2; exit 2 ;;
esac
