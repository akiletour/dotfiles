## Switch between all homebrew PHP versions
phpv() {
  brew unlink php && brew link --overwrite --force php@$1
}

sr() {
  /opt/homebrew/opt/php@$1/bin/php -d memory_limit=-1 /usr/local/bin/wp search-replace "$2" "$3" --all-tables --precise --skip-columns=guid
}

commit_changes() {
  local commit_message="$1"

  echo "Voulez-vous effectuer un commit avec le message suivant ? '$commit_message' (y/n)"
  read REPLY

  if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo "Effectuer le commit : $commit_message"
    git add --all && git commit --message "$commit_message"
  else
    echo "Commit annulé."
  fi
}


wpv() {
    phpversion=/opt/homebrew/opt/php@$1/bin/php
    shift

  $phpversion /usr/local/bin/wp "$@"
}

wps() {
  if [ -n "$1" ]; then
    phpversion=/opt/homebrew/opt/php@$1/bin/php
  else
    phpversion=/opt/homebrew/opt/php@$PHP_ENV/bin/php
  fi

  $phpversion /usr/local/bin/wp server --host=0.0.0.0 --port=8000
}

# Fonction pour mettre à jour tous les plugins
wpp() {
  wpv "$1" plugin update --all

  commit_changes "core(tma): update plugins before core upgrade"
}

# Fonction pour mettre à jour les langues des plugins
wpl() {
  wpv "$1" language plugin update --all
  wpv "$1" language core update

  commit_changes "core(tma): update translations before core upgrade"
}

# Fonction pour mettre à jour WordPress Core en français
wpc() {
  wpv "$1" core update --locale=fr_FR

  commit_changes "core(tma): upgrade to WordPress $(wpv "$1" core version)"
}

port() {
  lsof -i :$1
}

ml() {
  if [[ -f Makefile ]] && grep -q '^lint:' Makefile; then
    make lint
  elif [[ -f composer.json ]] && grep -q '"lint"' composer.json; then
    composer lint
  else
    echo "Pas de commande lint dans ce projet"
    return 1
  fi
}

mf() {
  if [[ -f Makefile ]] && grep -q '^fix:' Makefile; then
    make fix
  elif [[ -f composer.json ]] && grep -q '"lint:fix"' composer.json; then
    composer lint:fix
  else
    echo "Pas de commande fix dans ce projet"
    return 1
  fi
}

kubectl() {
  local arg ctx verb skip=0 want_ctx=0
  for arg in "$@"; do
    if (( want_ctx )); then ctx=$arg; want_ctx=0; continue; fi
    if (( skip )); then skip=0; continue; fi
    case $arg in
      --context=*) ctx=${arg#--context=} ;;
      --context) want_ctx=1 ;;
      -n|--namespace|-l|--selector|-o|--output|-f|--filename|-c|--container|--kubeconfig|--cluster|--user|-s|--server|--as) skip=1 ;;
      -*) ;;
      *) [[ -z $verb ]] && verb=$arg ;;
    esac
  done
  [[ -z $ctx ]] && ctx=$(command kubectl config current-context 2>/dev/null)
  if [[ $ctx == prod ]]; then
    case $verb in
      ""|get|describe|logs|top|explain|version|api-resources|api-versions|diff|events|cluster-info|config|completion|wait) ;;
      *)
        print -P "%F{red}%BContexte PROD%b%f : kubectl $*"
        read -q "?Confirmer ? [y/N] " || { echo; return 1; }
        echo
        ;;
    esac
  fi
  kubecolor "$@"
}

docker() {
  local arg ctx verb sub want_ctx=0 skip=0
  for arg in "$@"; do
    if (( want_ctx )); then ctx=$arg; want_ctx=0; continue; fi
    if (( skip )); then skip=0; continue; fi
    if [[ -z $verb ]]; then
      case $arg in
        --context=*|-c=*) ctx=${arg#*=} ;;
        --context|-c) want_ctx=1 ;;
        -H|--host|--config|-l|--log-level) skip=1 ;;
        -*) ;;
        *) verb=$arg ;;
      esac
    elif [[ -z $sub && $arg != -* ]]; then
      sub=$arg
    fi
  done
  case $verb in
    ""|ps|logs|inspect|images|info|version|stats|top|events|port|diff|history|help) ;;
    context)
      if [[ $sub == use ]] && _docker_is_swarm "${@[-1]}"; then
        print -P "%F{red}%Bdocker context use ${@[-1]}%b%f refusé : utilise --context ${@[-1]} ou swarm"
        return 1
      fi
      ;;
    service|stack|node|network|volume|config|secret|container|image|system)
      case $sub in
        ""|ls|ps|logs|inspect|services|df|info|events|top|stats|port|diff|history) ;;
        *) _docker_swarm_confirm "$ctx" "$@" || return 1 ;;
      esac
      ;;
    *) _docker_swarm_confirm "$ctx" "$@" || return 1 ;;
  esac
  command docker "$@"
}

_docker_is_swarm() {
  command docker context ls --format '{{.Name}}|{{.Description}}' 2>/dev/null | grep -qxF "$1|swarm"
}

_docker_swarm_confirm() {
  local ctx=$1; shift
  if [[ -z $ctx ]]; then
    [[ -n $DOCKER_HOST ]] && return 0
    ctx=${DOCKER_CONTEXT:-$(command docker context show 2>/dev/null)}
  fi
  _docker_is_swarm "$ctx" || return 0
  print -P "%F{red}%BSwarm $ctx%b%f : docker $*"
  read -q "?Confirmer ? [y/N] " || { echo; return 1; }
  echo
}

## Retrieve the current active WordPress theme
## if the current theme is a sage 9 theme, remove the "resources/" part
theme() {
  WP_THEME=$(wp option get template)

  cd "wp-content/themes/${WP_THEME/\/resources/}"
}

